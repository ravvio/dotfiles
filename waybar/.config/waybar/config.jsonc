{
    "layer": "top",
    "position": "bottom",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "height": 32,
    "modules-left": [
        "sway/workspaces",
        "sway/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "sway/language",
        "battery",
        "cpu",
        "disk",
        "pulseaudio",
        "pulseaudio#microphone",
        "tray",
        "custom/notification"
    ],
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='red'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "timezone": "Europe/Rome",
        "format": "  {:%a, %d %b    %H:%M}"
    },
    "temperature": {
        "hwmon-path": "",
        "format": "{icon} {temperatureC}°C",
        "format-icons": [
            "󱃃",
            "󰔏",
            "󱃂"
        ]
    },
    "battery": {
        "states": {
            "good": 100,
            "warning": 50,
            "critical": 25
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "tooltip-format": "{timeTo}\nPower: {power} W"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "tooltip": true,
        "tooltip-format": "{icon} {volume}%\n{desc}",
        "on-click": "~/dotfiles/scripts/volume --toggle-mute",
        "on-click-right": "pavucontrol",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        }
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "on-click": "~/dotfiles/scripts/volume --toggle-microphone",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "~/dotfiles/scripts/volume --increase-microphone",
        "on-scroll-down": "~/dotfiles/scripts/volume --increase-microphone",
        "scroll-step": 5,
        "tooltip": true,
        "tooltip-format": " {volume}%"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}",
        "format-alt-click": "click-right",
        "format-alt": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "on-scroll-up": "~/dotfiles/scripts/brightness --inc",
        "on-scroll-down": "~/dotfiles/scripts/brightness --dec"
    },
    "cpu": {
        "interval": 10,
        "format": " {usage}%",
        "max-length": 10,
        "on-click": "kitty --start-as=fullscreen --title btop sh -c 'btop'"
    },
    "disk": {
        "interval": 60,
        "format": " {percentage_used}%",
        "path": "/home"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 14
    },
    "sway/workspaces": {
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": [],
            "6": [],
            "7": [],
            "8": []
        }
    },
    "sway/window": {
        "format": "{}",
        "icon": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "$1",
            "tmux": " "
        }
    },
    "taskbar": {
        "on-click-right": "close"
    }
}
