[user]
    name = Alessio Raviola
[includeIf "gitdir:~/personal/"]
    path = .gitconfig.personal
[includeIf "gitdir:~/dotfiles/"]
    path = .gitconfig.personal
[includeIf "gitdir:~/projects/"]
    path = .gitconfig.personal
[includeIf "gitdir:~/tools/"]
    path = .gitconfig.personal
[includeIf "gitdir:~/codeploy/"]
    path = .gitconfig.codeploy
[gpg]
    program = gpg
    format = ssh
[commit]
    gpgsign = true
[tag]
    forcesignannotated = false
    gpgsign = true
[init]
    defaultbranch = main
[core]
    editor = nvim
    excludesfile = ~/dotfiles/git/.gitignore
[diff]
    tool = nvimdiff
[merge]
    tool = nvimdiff
    conflictstyle = diff3
[rerere]
    enabled = true
[pull]
    rebase = true
[column]
    ui = auto
[branch]
    sort = -committerdate
[grep]
    lineNumber = true
    patternType = perl
[alias]
    ss = status
    ci = commit
    br = branch
    wi = switch

    amend = commit --amend

    diffw = diff --word-diff
    difft = difftool
    merget = mergetool

    unstage = reset head --
    last = log -1 head
    logh = log --oneline --decorate --graph --all

    rld = reflog --date=iso

    blamec = blame -wccc

[maintenance]
    auto = false
    strategy = incremental

[includeIf "gitdir:~/codeploy/"]
    path = ~/codeploy/.gitconfig
[gpg "ssh"]
    allowedSignersFile = /home/alessio/dotfiles/git/allowed_signers
