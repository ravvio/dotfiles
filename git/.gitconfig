[user]
	email = alessio.raviola.98@gmail.com
	name = Alessio Raviola
	signingkey = /home/alessio/.ssh/gitpersonal.pub
[gpg]
	program = gpg
	format = ssh
[commit]
	gpgsign = true
[tag]
	forcesignannotated = false
[init]
	defaultbranch = main
[core]
	editor = nvim
[diff]
    tool = nvimdiff
[merge]
    tool = nvimdiff
[pull]
    rebase = false
[column]
	ui = auto
[branch]
    sort = -committerdate
[alias]
    ss = status
    ci = commit
    br = branch
    wi = switch

    difft = difftool
    merget = mergetool

	unstage = reset head --
    last = log -1 head
    logh = log --oneline --decorate --graph --all

    blameig = blame -wccc

[maintenance]
    auto = false
    strategy = incremental

[includeIf "gitdir:~/codeploy/"]
    path = ~/codeploy/.gitconfig
